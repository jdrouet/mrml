<mjml><mj-head><mj-title>Features</mj-title><mj-preview>FEATURE_PREVIEW</mj-preview><mj-breakpoint width="480px"/><mj-font name="Roboto" href="https://fonts.googleapis.com/css?family=Roboto"/></mj-head><mj-body><mj-wrapper background-color="#ffffff"><mj-section><mj-group><mj-column><mj-text>FEATURE_TEXT</mj-text><mj-image src="https://example.com/image.png" alt="FEATURE_IMAGE"/><mj-button href="https://example.com/action">FEATURE_BUTTON</mj-button><mj-divider/><mj-spacer/><mj-table><tr><td>FEATURE_TABLE</td></tr></mj-table><mj-social><mj-social-element name="facebook" href="https://example.com/social">FEATURE_SOCIAL</mj-social-element></mj-social><mj-navbar><mj-navbar-link href="https://example.com/nav">FEATURE_NAV</mj-navbar-link></mj-navbar></mj-column></mj-group></mj-section></mj-wrapper><mj-hero mode="fixed-height" height="200px" background-url="https://example.com/hero.png"><mj-text>FEATURE_HERO</mj-text></mj-hero><mj-section><mj-column><mj-accordion><mj-accordion-element><mj-accordion-title>FEATURE_ACCORDION_TITLE</mj-accordion-title><mj-accordion-text>FEATURE_ACCORDION_BODY</mj-accordion-text></mj-accordion-element></mj-accordion><mj-carousel><mj-carousel-image src="https://example.com/one.png" alt="FEATURE_CAROUSEL"/><mj-carousel-image src="https://example.com/two.png"/></mj-carousel><mj-raw><p>FEATURE_RAW</p></mj-raw></mj-column></mj-section></mj-body></mjml>